# Environment name, by default "dev" will print errors and stack traces to the user.
APP_ENV=dev

# Tell the application about the location of important files.
PATH_CONTAINER=config/container.php
PATH_CONTROLLERS=src/Controllers
PATH_COMMANDS=src/Commands
PATH_TEMPLATES=src/Templates

# Compile and cache components that are otherwise expensive to execute on each page load.
#CACHE_CONTAINER=var/cache/container
#CACHE_CONTROLLERS=var/cache/controllers
#CACHE_COMMANDS=var/cache/commands
#CACHE_TEMPLATES=var/cache/templates

# The minimum level to be logged for HTTP requests.
# Most HTTP exceptions in the 400 range are configured to log as NOTICE,
# while other uncaught exceptions (resulting in 500 response codes) logs as CRITICAL.
LOG_LEVEL=warning
# Target log stream.
LOG_STREAM=php://stderr
# Can also be a file path relative to application root directory:
#LOG_STREAM=var/log/default.log

# Default credentials for Basic Auth. Password hash from `password_hash()`, currently "demo".
BASIC_AUTH_USER=demo
BASIC_AUTH_PASSWORD=$2y$12$MPl3ENpLZ.QwmbUYrzUjFe.H0A7.RXp/rxy8lAlNb8qlEkLFHIPWC