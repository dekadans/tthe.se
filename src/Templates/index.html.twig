{% extends "base.html.twig" %}

{% block title %}Tomas Thelander{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="description" content="Integration Specialist and Software Developer based in Gothenburg, Sweden">
    <meta property="og:title" content="Tomas Thelander">
    <meta property="og:description" content="Integration Specialist and Software Developer based in Gothenburg, Sweden">
    <meta property="og:image" content="/images/tthe.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <script defer src="https://use.fontawesome.com/releases/v5.3.1/js/all.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
    <style>
        #mail-container {
            font-size: 0.7rem;
            font-family: monospace;
            margin-top: 0.5rem;
        }

        .mail-component-b {
            display: none;
        }

        footer {
            text-align: right;
        }
    </style>
{% endblock %}

{% block content %}
    <header class="container">
        <nav>
            <ul>
                <li><strong>Tomas Thelander</strong></li>
            </ul>
            <!--<ul>
                <li>
                    <a role="button" class="secondary" href="/me.html">CV</a>
                </li>
            </ul>-->
        </nav>
    </header>
    <main class="container">
        <section class="grid">
            <div>
                <h1>Tomas Thelander</h1>
                <p>
                    <button>Read my CV</button>
                </p>
                <!--<p>
                    Lorem ipsum dolor sit amet consectetur adipiscing elit porta donec auctor pretium, integer fusce nascetur scelerisque hac felis ultrices placerat cursus potenti.
                </p>-->
            </div>
            <div>
                <article>
                    <header><strong>Activity</strong></header>
                    <details name="activity">
                        <summary role="button" class="secondary outline" hx-get="/activity/film/widget" hx-trigger="click once" hx-target="#filmActivity">
                            Movies
                        </summary>
                        <div id="filmActivity">
                            <p>Loading...</p>
                        </div>
                    </details>
                    <details name="activity">
                        <summary role="button" class="secondary outline" hx-get="/activity/book/widget" hx-trigger="click once" hx-target="#bookActivity">
                            Books
                        </summary>
                        <div id="bookActivity">
                            <p>Loading...</p>
                        </div>
                    </details>
                </article>
            </div>
        </section>
    </main>
    <footer class="container">
        <small>tthe.se | © 2026 Tomas Thelander</small>
    </footer>
{% endblock %}